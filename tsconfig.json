{
	"compilerOptions": {
		"target": "es2021",
		"module": "commonjs",
		"strict": true,
		"noEmit": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"paths": {
			"@/*": ["./src/*"],
			"@tests/*": ["./tests/*"],
			"@utils/*": ["./tests/utils"]
		}
	},
	"include": ["**/*.ts"]
}
