{
	"name": "playwright-bdd-example",
	"version": "0.1.0",
	"scripts": {
		"debug": "bddgen && playwright test --debug",
		"test": "bddgen && playwright test",
		"watch:bdd": "nodemon -w ./features -e feature,js,ts --exec \"npx bddgen\"",
		"watch:pw": "playwright test --ui",
		"watch": "run-p watch:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.3",
		"http-server": "14.1.1",
		"nodemon": "^3.1.14",
		"npm-run-all": "^4.1.5",
		"playwright-bdd": "^9.2.1",
		"prettier": "^3.9.9",
		"prettier-plugin-gherkin": "^4.0.0",
		"typescript": "^7.0.2"
	}
}
