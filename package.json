{
	"name": "playwright-bdd-example",
	"version": "0.1.0",
	"scripts": {
		"debug": "bddgen && playwright test --debug",
		"test": "bddgen && playwright test",
		"watch:bdd": "nodemon -w ./features -w ./steps -e feature,js,ts --exec \"bddgen\"",
		"watch:pw": "playwright test --ui",
		"watch": "run-p watch:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@types/node": "^20.9.4",
		"bddgen": "^1.0.5",
		"dotenv": "^16.4.5",
		"nodemon": "^3.0.1",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.47.1",
		"playwright-bdd": "^8.2.1",
		"typescript": "^5.3.2"
	}
}
